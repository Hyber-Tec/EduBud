{
  "hosting": {
    "public": "web/build/client",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "__spa-fallback.html"
    ],
    "redirects": [
      {
        "source": "/learning-center",
        "destination": "/day-learning-program",
        "type": 302
      },
      {
        "source": "/initiatives",
        "destination": "/community-chapters",
        "type": 302
      },
      {
        "source": "/current-projects",
        "destination": "/golden-bridge-project",
        "type": 302
      },
      {
        "source": "/past-projects",
        "destination": "/blue-bridge-project",
        "type": 302
      },
      {
        "source": "/about-us",
        "destination": "/our-team",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/@(media|fonts)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
