      "--accordion-description-padding-right": "0px",
      "--accordion-description-width": "70%",
      "--accordion-divider-thickness": "1px",
      "--accordion-divider-opacity": "1",
      "--stroke-style": "none",
      "--stroke-thickness": "6px",
      "--tweak-accordion-block-background-color": "hsla(0, 0%, 100%, 0.2)",
      "--tweak-accordion-block-padding": "initial",
      "--tweak-accordion-block-radius": "0px 0px 0px 0px",
      "--tweak-accordion-block-blend": "normal",
      "--blur-value": "blur(15px)"
     },
     "varsMobile": {},
     "css": "[data-block=\"4bd107c0ba263b8a44aa\"] { mix-blend-mode: var(--tweak-accordion-block-blend\n); border-radius: var(--tweak-accordion-block-radius); }",
     "type": "accordion",
     "items": [
      {
       "title": "Is EduBud the Right Fit?",
       "html": "<p style=\"white-space:pre-wrap;\">Because EduBud is a community-based educational and social program, rather than a medical or intensive behavioral treatment facility, participants must be able to safely participate within our available level of staffing and support.</p>"
      },
      {
       "title": "What is the process for enrollment?",
       "html": "<p style=\"white-space:pre-wrap;\">To share information about the participant's Communication needs, Level of independence, Behavioral and emotional support needs, Medical or safety considerations, Elopement/wandering concerns, Aggression or self-injurious behaviors, if applicable, Toileting and personal-care needs, Sensory needs and triggers, Strategies that help with regulation, Allergies, medications, and emergency information. Providing complete and accurate information helps our team determine how we can best support each participant and keep everyone safe.</p>"
      },
      {
       "title": "What are some program expectations?",
       "html": "<p style=\"white-space:pre-wrap;\">Respecting peers, instructors, volunteers, and personal space, Following basic safety directions, Participating in activities at their individual ability level, Communicating needs appropriately, with support when needed, Taking turns and participating in group activities, Using appropriate strategies or requesting breaks when overwhelmed. We understand that every participant communicates, learns, and regulates differently. Needing accommodations, breaks, visual supports, repeated directions, or additional processing time is completely okay.</p>"
      }
     ],
     "firstOpen": false,
     "allowMultiple": false,
     "dividers": {
      "enabled": true,
      "first": true,
      "last": true
     },
     "icon": "plus",
     "titleClass": "",
     "descriptionClass": "",
     "titleAlign": "left",
     "descriptionAlign": "left",
     "iconPlacement": "right"
    },
