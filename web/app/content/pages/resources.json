     "type": "text",
     "html": "<h3 style=\"white-space:pre-wrap;\">❋ Educational Guidance &amp; Family Consultations</h3>"
    },
    {
     "id": "2a8e0427d3cbab2b2c2a",
     "mobile": {
      "rowStart": 8,
      "colStart": 2,
      "rowEnd": 11,
      "colEnd": 10,
      "z": 6,
      "justify": "flex-start",
      "align": "flex-start"
     },
     "desktop": {
      "rowStart": 8,
      "colStart": 4,
      "rowEnd": 10,
      "colEnd": 12,
      "z": 6,
      "justify": "flex-start",
      "align": "flex-start"
     },
     "vars": {
      "--stroke-style": "none",
      "--stroke-thickness": "6px",
      "--tweak-text-block-padding": "initial",
      "--tweak-text-block-radius": "0px 0px 0px 0px",
      "--tweak-text-block-blend": "normal",
      "--blur-value": "blur(15px)"
     },
     "varsMobile": {},
     "css": "[data-block=\"2a8e0427d3cbab2b2c2a\"] { mix-blend-mode: var(--tweak-text-block-blend\n  ); border-radius: var(--tweak-text-block-radius); }",
     "type": "text",
     "html": "<p style=\"white-space:pre-wrap;\" class=\"rte-large\">Modules are sequenced to build competencies progressively, ensuring concepts are retained and applied with confidence.</p>"
    },
    {
     "id": "a103ca3a1957afda7538",
     "mobile": {
      "rowStart": 13,
      "colStart": 2,
      "rowEnd": 21,
      "colEnd": 10,
      "z": 7,
      "justify": "flex-start",
      "align": "flex-start"
     },
     "desktop": {
      "rowStart": 15,
      "colStart": 4,
      "rowEnd": 19,
      "colEnd": 12,
      "z": 7,
      "justify": "flex-start",
      "align": "flex-start"
     },
     "vars": {
      "--stroke-style": "none",
      "--stroke-thickness": "6px",
      "--tweak-text-block-padding": "initial",
      "--tweak-text-block-radius": "0px 0px 0px 0px",
      "--tweak-text-block-blend": "normal",
      "--blur-value": "blur(15px)"
     },
     "varsMobile": {},
     "css": "[data-block=\"a103ca3a1957afda7538\"] { mix-blend-mode: var(--tweak-text-block-blend\n  ); border-radius: var(--tweak-text-block-radius); }",
     "type": "text",
     "html": "<p class=\"rte-large\" style=\"white-space:pre-wrap;\">We help families identify potential funding opportunities and connect with resources. We can help families navigate Georgia Medicaid waiver programs and explore funding options such as CAG and CAI, when applicable, to better understand eligibility, available support, and next steps.</p><p style=\"white-space:pre-wrap;\">Resources may include scholarships, public benefits, waiver programs, and nonprofit assistance. Eligibility and availability vary by program.</p>"
    },
